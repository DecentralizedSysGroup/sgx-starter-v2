enclave {
    from "openenclave/edl/syscall.edl" import *;
    from "platform.edl" import *;

    trusted {
        public void generate_rsa_key(
            [out, size=pub_key_size] uint8_t* pub_key,
            size_t pub_key_size,
            [out, size=evidence_cap] uint8_t* evidence,
            size_t evidence_cap,
            [out] size_t* evidence_used);
    };
};


